// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Render production deploys should provide DATABASE_URL for PostgreSQL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppleCarePricing {
  id          Int      @id @default(autoincrement())
  partNumber  String   @unique
  description String
  sell        Decimal  @db.Decimal(12, 4)
  sellWithVat Decimal  @db.Decimal(12, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productMappings AppleCareProductMapping[]
}

model AppleCareProductMapping {
  id                  Int              @id @default(autoincrement())
  shop                String
  shopifyProductId    String
  shopifyProductTitle String
  shopifyVariantId    String
  shopifyVariantTitle String?
  shopifySku          String?
  appleCarePricingId  Int
  appleCarePartNumber String
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  appleCarePricing    AppleCarePricing @relation(fields: [appleCarePricingId], references: [id], onDelete: Restrict)

  @@index([shop, shopifyVariantId])
  @@index([appleCarePricingId])
}
