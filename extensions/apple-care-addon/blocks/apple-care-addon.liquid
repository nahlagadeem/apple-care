{% assign apple_care_variant = product.selected_or_first_available_variant | default: product.variants.first %}

<style>
  .apple-care-addon {
    margin-top: 0.9rem;
    overflow: hidden;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 260ms ease,
      transform 260ms ease,
      max-height 320ms ease;
  }

  .apple-care-addon[hidden] {
    display: none !important;
  }

  .apple-care-addon__card {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 0.95rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 9px 24px rgba(0, 0, 0, 0.055);
    padding: 0.9rem;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .apple-care-addon__card:hover {
    border-color: rgba(0, 0, 0, 0.16);
    box-shadow: 0 13px 30px rgba(0, 0, 0, 0.075);
    transform: translateY(-1px);
  }

  .apple-care-addon__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    overflow: hidden;
    background: #f7f7f8;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
  }

  .apple-care-addon__icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .apple-care-addon__title {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.25;
    font-weight: 700;
    color: #1d1d1f;
  }

  .apple-care-addon__subtitle {
    margin: 0.22rem 0 0;
    color: #5f5f65;
    font-size: 0.91rem;
    line-height: 1.38;
  }

  .apple-care-addon__benefits {
    display: grid;
    gap: 0.32rem;
    margin: 0.72rem 0 0;
    padding: 0;
    list-style: none;
  }

  .apple-care-addon__benefits li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #3f3f46;
    font-size: 0.86rem;
    line-height: 1.32;
  }

  .apple-care-addon__benefits li::before {
    content: "✓";
    display: grid;
    place-items: center;
    width: 0.95rem;
    height: 0.95rem;
    color: #188038;
    font-size: 0.77rem;
    line-height: 1;
    font-weight: 700;
    flex: 0 0 auto;
  }

  .apple-care-addon__footer {
    display: grid;
    grid-template-columns: minmax(7.5rem, 1fr) minmax(0, auto);
    align-items: flex-start;
    justify-content: space-between;
    grid-column: 1 / -1;
    gap: 0.85rem;
    margin-top: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 0.75rem;
  }

  .apple-care-addon__price-wrap {
    min-width: 8.5rem;
  }

  .apple-care-addon__price {
    color: #1d1d1f;
    font-size: 1rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0;
  }

  .apple-care-addon__vat {
    margin: 0.18rem 0 0;
    color: #6e6e73;
    font-size: 0.78rem;
    line-height: 1.25;
  }

  .apple-care-addon__toggle-wrap {
    display: grid;
    justify-items: end;
    gap: 0.2rem;
    min-width: 0;
    max-width: 13.5rem;
    text-align: right;
  }

  .apple-care-addon__toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: auto;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
    color: #1d1d1f;
    font-size: 0.93rem;
    line-height: 1.2;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    white-space: normal;
    min-width: 0;
    justify-content: flex-end;
  }

  .apple-care-addon__toggle:hover {
    color: #0066cc;
  }

  .apple-care-addon__toggle input {
    position: static;
    width: 18px;
    height: 18px;
    margin: 0;
    opacity: 1;
    pointer-events: auto;
    accent-color: #0071e3;
    flex: 0 0 auto;
  }

  .apple-care-addon__check {
    display: none;
  }

  .apple-care-addon__selected-text {
    display: none;
  }

  .apple-care-addon__toggle:has(input:checked) .apple-care-addon__default-text {
    display: none;
  }

  .apple-care-addon__toggle:has(input:checked) .apple-care-addon__selected-text {
    display: inline;
  }

  .apple-care-addon__helper,
  .apple-care-addon__selected-helper {
    margin: 0;
    color: #6e6e73;
    font-size: 0.78rem;
    line-height: 1.25;
    max-width: 12rem;
    text-align: right;
  }

  .apple-care-addon__selected-helper {
    display: none;
    color: #188038;
  }

  .apple-care-addon__toggle-wrap:has(input:checked) .apple-care-addon__helper {
    display: none;
  }

  .apple-care-addon__toggle-wrap:has(input:checked) .apple-care-addon__selected-helper {
    display: block;
  }

  .apple-care-addon__loading,
  .apple-care-addon__error {
    display: none;
    grid-column: 1 / -1;
  }

  .apple-care-addon[data-state="loading"] .apple-care-addon__content,
  .apple-care-addon[data-state="loading"] .apple-care-addon__icon,
  .apple-care-addon[data-state="loading"] .apple-care-addon__footer,
  .apple-care-addon[data-state="error"] .apple-care-addon__content {
    display: none;
  }

  .apple-care-addon[data-state="loading"] .apple-care-addon__loading,
  .apple-care-addon[data-state="error"] .apple-care-addon__error {
    display: block;
  }

  .apple-care-addon__skeleton-line {
    height: 0.82rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #f0f1f3 0%, #fafafa 48%, #f0f1f3 100%);
    background-size: 220% 100%;
    animation: apple-care-shimmer 1.1s linear infinite;
  }

  .apple-care-addon__skeleton-line + .apple-care-addon__skeleton-line {
    margin-top: 0.65rem;
  }

  .apple-care-addon__skeleton-line:nth-child(1) {
    width: 46%;
    height: 1rem;
  }

  .apple-care-addon__skeleton-line:nth-child(2) {
    width: 78%;
  }

  .apple-care-addon__skeleton-line:nth-child(3) {
    width: 58%;
  }

  .apple-care-addon__loading-text,
  .apple-care-addon__error-title {
    margin: 0;
    color: #1d1d1f;
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .apple-care-addon__loading-text {
    margin-top: 0.85rem;
    color: #6e6e73;
    font-weight: 500;
  }

  .apple-care-addon__error-text {
    margin: 0.3rem 0 0;
    color: #6e6e73;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .apple-care-addon[data-state="ready"] {
    animation: apple-care-reveal 300ms ease both;
  }

  @keyframes apple-care-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes apple-care-shimmer {
    from {
      background-position: 120% 0;
    }

    to {
      background-position: -120% 0;
    }
  }

  @media screen and (max-width: 749px) {
    .apple-care-addon__card {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 0.75rem;
      border-radius: 14px;
      padding: 0.85rem;
    }

    .apple-care-addon__icon {
      width: 38px;
      height: 38px;
      border-radius: 12px;
    }

    .apple-care-addon__footer {
      align-items: stretch;
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .apple-care-addon__price-wrap {
      min-width: 0;
    }

    .apple-care-addon__toggle {
      justify-content: flex-start;
      width: 100%;
      white-space: normal;
      text-align: left;
    }

    .apple-care-addon__toggle-wrap,
    .apple-care-addon__helper,
    .apple-care-addon__selected-helper {
      max-width: none;
      text-align: left;
    }

    .apple-care-addon__toggle-wrap {
      justify-items: start;
    }
  }
</style>

<div
  class="apple-care-addon"
  data-apple-care-addon
  data-lookup-url="/apps/apple-care/lookup"
  data-initial-variant-id="{{ apple_care_variant.id }}"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  hidden
>
  <div class="apple-care-addon__card">
    <div class="apple-care-addon__icon" aria-hidden="true">
      <img
        src="{{ 'apple-care.svg' | asset_url }}"
        alt=""
        width="44"
        height="44"
        loading="lazy"
      >
    </div>

    <div class="apple-care-addon__content">
      <h3 class="apple-care-addon__title">AppleCare+</h3>
      <p class="apple-care-addon__subtitle">Protect your device with AppleCare+.</p>
      <p class="apple-care-addon__subtitle" data-apple-care-product-title hidden></p>

      <ul class="apple-care-addon__benefits" aria-label="AppleCare benefits">
        <li>Priority support from Apple experts</li>
        <li>Accidental damage coverage</li>
        <li>Hardware coverage and service</li>
      </ul>
    </div>

    <div class="apple-care-addon__footer">
      <div class="apple-care-addon__price-wrap">
        <div class="apple-care-addon__price" data-apple-care-price></div>
        <p class="apple-care-addon__vat">Price includes VAT</p>
      </div>
      <div class="apple-care-addon__toggle-wrap">
        <label class="apple-care-addon__toggle">
          <input type="checkbox" data-apple-care-toggle />
          <span class="apple-care-addon__check" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none">
              <path d="m2.4 6.2 2.1 2.1 5.1-5.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="apple-care-addon__default-text">Add AppleCare+</span>
          <span class="apple-care-addon__selected-text">AppleCare will be added</span>
        </label>
        <p class="apple-care-addon__helper">Will be added to your cart</p>
        <p class="apple-care-addon__selected-helper">AppleCare will be added</p>
      </div>
    </div>

    <div class="apple-care-addon__loading" aria-live="polite">
      <div class="apple-care-addon__skeleton-line"></div>
      <div class="apple-care-addon__skeleton-line"></div>
      <div class="apple-care-addon__skeleton-line"></div>
      <p class="apple-care-addon__loading-text">Loading AppleCare...</p>
    </div>

    <div class="apple-care-addon__error" role="status">
      <p class="apple-care-addon__error-title">AppleCare is temporarily unavailable.</p>
      <p class="apple-care-addon__error-text">Please try changing the variant or refreshing the page.</p>
    </div>
  </div>
</div>

<script>
  (() => {
    const INIT_FLAG = "appleCareInitialized";
    const FORM_INIT_FLAG = "appleCareFormInitialized";
    const LOOKUP_DELAY_MS = 100;
    const POLL_INTERVAL_MS = 250;
    const ERROR_PREFIX = "[AppleCare Add-on]";

    const normalizeVariantId = (value) => {
      const raw = String(value || "").trim();
      if (!raw) return "";

      const gidMatch = raw.match(/^gid:\/\/shopify\/ProductVariant\/(\d+)$/);
      if (gidMatch) return gidMatch[1];
      if (/^\d+$/.test(raw)) return raw;

      return "";
    };

    const findVariantInput = (root) => {
      const form =
        root.closest("form") ||
        root.closest("section")?.querySelector('form[action*="/cart/add"]') ||
        document.querySelector('form[action*="/cart/add"]');

      if (!form) return null;

      return form.querySelector('input[name="id"]');
    };

    const fetchAppleCare = async (lookupUrl, variantId) => {
      const response = await fetch(`${lookupUrl}?variantId=${encodeURIComponent(variantId)}`, {
        headers: {
          Accept: "application/json",
        },
        cache: "no-store",
        credentials: "same-origin",
      });

      if (!response.ok) {
        throw new Error(`Lookup failed with status ${response.status}`);
      }

      const payload = await response.json();
      return payload;
    };

    const getQuantity = (form) => {
      const quantityInput = form.querySelector('input[name="quantity"], select[name="quantity"]');
      const quantity = Number(quantityInput?.value || 1);
      return Number.isFinite(quantity) && quantity > 0 ? quantity : 1;
    };

    const getProperties = (form) => {
      const properties = {};
      const formData = new FormData(form);

      for (const [key, value] of formData.entries()) {
        const match = key.match(/^properties\[(.+)\]$/);
        if (!match || value === "") continue;
        properties[match[1]] = value;
      }

      return properties;
    };

    const getCartSectionIds = () =>
      Array.from(document.querySelectorAll("cart-items-component[data-section-id]"))
        .map((item) => item.dataset.sectionId)
        .filter(Boolean);

    const getCartAddUrl = () => {
      if (window.Theme?.routes?.cart_add_url) return window.Theme.routes.cart_add_url;
      return `${window.Shopify?.routes?.root || "/"}cart/add.js`;
    };

    const shouldAddAppleCare = (root, state) =>
      Boolean(state.toggleEl?.checked && state.appleCareVariantId && !root.hidden);

    const dispatchCartUpdate = (root, form, response, quantity) => {
      const event = new Event("cart:update", { bubbles: true });
      event.detail = {
        resource: response,
        sourceId: form.id || "apple-care-addon",
        data: {
          source: "product-form-component",
          itemCount: quantity,
          productId: root.dataset.productId,
          sections: response.sections,
        },
      };

      form.dispatchEvent(event);
    };

    const addBundleToCart = async (root, form, state) => {
      const mainVariantId = normalizeVariantId(form.querySelector('input[name="id"]')?.value);
      const appleCareVariantId = normalizeVariantId(state.appleCareVariantId);

      if (!mainVariantId || !appleCareVariantId) return;

      const quantity = getQuantity(form);
      const cartSectionIds = getCartSectionIds();
      const payload = buildCartPayload(root, form, state, mainVariantId, appleCareVariantId, quantity);

      const sellingPlan = form.querySelector('[name="selling_plan"]')?.value;
      if (sellingPlan) payload.items[0].selling_plan = sellingPlan;

      if (cartSectionIds.length) {
        payload.sections = cartSectionIds.join(",");
        payload.sections_url = window.location.pathname;
      }

      const response = await fetch(getCartAddUrl(), {
        method: "POST",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const data = await response.json();

      if (!response.ok || data.status) {
        throw new Error(data.description || data.message || "Unable to add AppleCare to cart");
      }

      dispatchCartUpdate(root, form, data, quantity);
    };

    const buildCartPayload = (root, form, state, mainVariantId, appleCareVariantId, quantity) => ({
      items: [
        {
          id: Number(mainVariantId),
          quantity,
          properties: getProperties(form),
        },
        {
          id: Number(appleCareVariantId),
          quantity,
          properties: {
            _apple_care_addon: "true",
            _apple_care_parent_variant_id: mainVariantId,
            _apple_care_parent_product_id: root.dataset.productId || "",
            _apple_care_parent_title: root.dataset.productTitle || "",
            ...(state.forDevice ? { _apple_care_for_device: state.forDevice } : {}),
          },
        },
      ],
    });

    const installFetchInterceptor = () => {
      if (window.__appleCareFetchInterceptor?.installed) return window.__appleCareFetchInterceptor;

      const interceptor = {
        installed: true,
        nativeFetch: window.fetch.bind(window),
        entries: [],
      };

      window.__appleCareFetchInterceptor = interceptor;

      window.fetch = (input, init = {}) => {
        const url = input instanceof Request ? input.url : String(input || "");
        const method = String(init.method || (input instanceof Request ? input.method : "GET") || "GET").toUpperCase();
        const body = init.body || null;
        const isCartAdd = /\/cart\/add(\.js)?(?:\?|$)/.test(url);

        if (!isCartAdd || method !== "POST" || !(body instanceof FormData)) {
          return interceptor.nativeFetch(input, init);
        }

        const submittedVariantId = normalizeVariantId(body.get("id"));
        const entry = interceptor.entries.find((candidate) => {
          const formVariantId = normalizeVariantId(candidate.form.querySelector('input[name="id"]')?.value);
          return formVariantId && formVariantId === submittedVariantId && shouldAddAppleCare(candidate.root, candidate.state);
        });

        if (!entry) return interceptor.nativeFetch(input, init);

        const mainVariantId = normalizeVariantId(entry.form.querySelector('input[name="id"]')?.value);
        const appleCareVariantId = normalizeVariantId(entry.state.appleCareVariantId);
        const quantity = getQuantity(entry.form);

        if (!mainVariantId || !appleCareVariantId) return interceptor.nativeFetch(input, init);

        const payload = buildCartPayload(entry.root, entry.form, entry.state, mainVariantId, appleCareVariantId, quantity);
        const sellingPlan = entry.form.querySelector('[name="selling_plan"]')?.value;
        const cartSectionIds = getCartSectionIds();

        if (sellingPlan) payload.items[0].selling_plan = sellingPlan;
        if (cartSectionIds.length) {
          payload.sections = cartSectionIds.join(",");
          payload.sections_url = window.location.pathname;
        }

        return interceptor.nativeFetch(getCartAddUrl(), {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          credentials: init.credentials || "same-origin",
          body: JSON.stringify(payload),
        });
      };

      return interceptor;
    };

    const enhanceProductForm = (root, form, state) => {
      if (!form || form.dataset[FORM_INIT_FLAG] === "true") return;
      form.dataset[FORM_INIT_FLAG] = "true";

      const fetchInterceptor = installFetchInterceptor();
      fetchInterceptor.entries = fetchInterceptor.entries.filter((entry) => entry.form !== form);
      fetchInterceptor.entries.push({ root, form, state });

      let isAddingBundle = false;

      const runAppleCareAdd = async (event) => {
        if (!shouldAddAppleCare(root, state)) return false;

        event.preventDefault();
        event.stopImmediatePropagation();

        if (isAddingBundle) return true;
        isAddingBundle = true;

        const submitter = event.submitter;
        const buttons = Array.from(
          form.querySelectorAll('button[type="submit"], button[name="add"], input[type="submit"]'),
        );

        buttons.forEach((button) => {
          button.disabled = true;
          button.setAttribute("aria-busy", "true");
        });

        try {
          await addBundleToCart(root, form, state);
        } catch (error) {
          console.error(ERROR_PREFIX, error);
          window.alert(error.message || "Unable to add AppleCare to cart");
        } finally {
          buttons.forEach((button) => {
            button.disabled = false;
            button.removeAttribute("aria-busy");
          });

          if (submitter instanceof HTMLElement) {
            submitter.focus();
          }

          isAddingBundle = false;
        }

        return true;
      };

      const handleSubmit = async (event) => {
        if (event.target !== form) return;

        await runAppleCareAdd(event);
      };

      const handleClick = async (event) => {
        const button = event.target?.closest?.(
          'button[name="add"], add-to-cart-component button, [ref="addToCartButton"]',
        );

        if (!button || !form.contains(button)) return;

        await runAppleCareAdd(event);
      };

      window.addEventListener(
        "submit",
        handleSubmit,
        true,
      );
      window.addEventListener("click", handleClick, true);

      root.addEventListener("shopify:section:unload", () => {
        window.removeEventListener("submit", handleSubmit, true);
        window.removeEventListener("click", handleClick, true);
        fetchInterceptor.entries = fetchInterceptor.entries.filter((entry) => entry.form !== form);
        delete form.dataset[FORM_INIT_FLAG];
      });
    };

    const initRoot = (root) => {
      if (root.dataset[INIT_FLAG] === "true") return;
      root.dataset[INIT_FLAG] = "true";

      const lookupUrl = root.dataset.lookupUrl;
      const titleEl = root.querySelector("[data-apple-care-product-title]");
      const priceEl = root.querySelector("[data-apple-care-price]");
      const toggleEl = root.querySelector("[data-apple-care-toggle]");
      const variantInput = findVariantInput(root);
      const form = variantInput?.form;
      const state = {
        appleCareVariantId: "",
        forDevice: "",
        toggleEl,
      };

      let timerId = null;
      let pollId = null;
      let lastRequestedVariantId = "";

      const setState = (stateName) => {
        root.dataset.state = stateName;
      };

      const setVisible = (visible) => {
        root.hidden = !visible;
      };

      const formatPrice = (price) => {
        const raw = String(price || "").trim();
        if (!raw) return "";
        if (/^(SAR|ر\.س)/i.test(raw)) return raw;
        return `SAR ${raw}`;
      };

      const render = (payload) => {
        if (!payload?.ok || !payload.hasAppleCare) {
          state.appleCareVariantId = "";
          state.forDevice = "";
          if (toggleEl) toggleEl.checked = false;
          setVisible(false);
          return;
        }

        const appleCare = payload.appleCare || {};
        state.appleCareVariantId = normalizeVariantId(appleCare.variantId);
        state.forDevice = String(appleCare.forDevice || "").trim();

        if (!state.appleCareVariantId) {
          state.forDevice = "";
          if (toggleEl) toggleEl.checked = false;
          setVisible(false);
          return;
        }

        if (titleEl) titleEl.textContent = appleCare.productTitle || "AppleCare+";
        if (priceEl) priceEl.textContent = formatPrice(appleCare.price);
        if (toggleEl) toggleEl.checked = false;

        setVisible(true);
        setState("ready");
      };

      const load = async () => {
        const currentVariantId = normalizeVariantId(
          variantInput?.value || root.dataset.initialVariantId,
        );

        if (!currentVariantId || currentVariantId === lastRequestedVariantId) {
          return;
        }

        lastRequestedVariantId = currentVariantId;

        try {
          setState("loading");
          setVisible(true);
          const payload = await fetchAppleCare(lookupUrl, currentVariantId);
          render(payload);
        } catch (error) {
          state.appleCareVariantId = "";
          state.forDevice = "";
          if (toggleEl) toggleEl.checked = false;
          setVisible(true);
          setState("error");
        }
      };

      const schedule = () => {
        window.clearTimeout(timerId);
        timerId = window.setTimeout(load, LOOKUP_DELAY_MS);
      };

      if (variantInput) {
        variantInput.addEventListener("change", schedule);
        variantInput.addEventListener("input", schedule);
      }

      document.addEventListener(
        "change",
        (event) => {
          if (!variantInput?.form || !variantInput.form.contains(event.target)) return;
          schedule();
        },
        true,
      );

      document.addEventListener(
        "input",
        (event) => {
          if (!variantInput?.form || !variantInput.form.contains(event.target)) return;
          schedule();
        },
        true,
      );

      document.addEventListener("variant:change", schedule);
      document.addEventListener("product:variant-change", schedule);
      enhanceProductForm(root, form, state);

      pollId = window.setInterval(() => {
        const currentVariantId = normalizeVariantId(
          variantInput?.value || root.dataset.initialVariantId,
        );

        if (currentVariantId && currentVariantId !== lastRequestedVariantId) {
          schedule();
        }
      }, POLL_INTERVAL_MS);

      schedule();

      root.addEventListener("shopify:section:unload", () => {
        window.clearTimeout(timerId);
        window.clearInterval(pollId);
      });
    };

    const initAll = (scope = document) => {
      scope.querySelectorAll("[data-apple-care-addon]").forEach(initRoot);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => initAll());
    } else {
      initAll();
    }

    document.addEventListener("shopify:section:load", (event) => {
      initAll(event.target);
    });
  })();
</script>

